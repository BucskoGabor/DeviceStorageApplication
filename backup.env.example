# ===== Backup Container Environment =====
# Ezt a fájlt a backup konténer tölti be env_file direktívával.
# A backend .env fájljától ELKÜLÖNÍTETT, hogy a backup konténer
# ne férjen hozzá a backend titkaihoz (JWT key, SMTP password, stb.).

# ===== PostgreSQL Connection (postgres host a docker-compose network-ön belül) =====
POSTGRES_HOST=postgres
POSTGRES_DB=tanszek_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-in-production

# ===== Backup Retention =====
BACKUP_RETENTION_DAYS=30