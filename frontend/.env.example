# Frontend environment variables (Vite prefix: VITE_)
# A Vite a VITE_ prefix-szel ellátott env var-okat beépíti a bundle-be.
# Production build esetén a frontend az Nginx reverse proxy-n át éri el a backendet (same-origin).

# Az alapértelmezett API URL a Vite proxy-n át megy (http://localhost:8080)
# Vagy közvetlen URL a backend-hez (production esetén relative path ajánlott)
VITE_API_BASE_URL=http://localhost:8080

# App metadata
VITE_APP_NAME=Device Storage